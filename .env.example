# Set these in your shell before starting. No external services are required.
HOST=127.0.0.1
PORT=3000
ADVISORY_DATA_DIR=./data
# Disable disposable sample accounts before team deployment.
ADVISORY_ALLOW_DEMO=1
# Set to 1 to require a team invitation code for every new account after the first.
ADVISORY_REQUIRE_INVITE=0
# Set to 1 only behind a local reverse proxy (e.g. Tailscale Funnel) so sign-in
# rate limits apply per visitor instead of to the proxy's loopback address.
ADVISORY_TRUST_PROXY=0
# Set to 1 behind an HTTPS reverse proxy. Cookies will require HTTPS.
ADVISORY_SECURE_COOKIE=0
# For an internal reverse proxy, specify its exact browser origin.
# ADVISORY_ORIGIN=https://advisory.internal.example
